local function isVisible(part)
	local cam = workspace.CurrentCamera
	if not cam then return false end
	local origin = cam.CFrame.Position
	local dir = part.Position - origin
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	pcall(function()
		params.FilterType = Enum.RaycastFilterType.Exclude
	end)
	local result = workspace:Raycast(origin, dir, params)
	if not result then return true end
	return result.Instance:IsDescendantOf(part.Parent)
end

local function getTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local best = nil
	local bestDist = math.huge
	local ping = getPing()

	for _, plr in ipairs(Players:GetPlayers()) do
		if not isLocal(plr) and not isTeammate(plr) then
			local char, hum, root = alive(plr)
			if char then
				local part
				if Config.aimPart == "Head" then
					part = char:FindFirstChild("Head") or root
				else
					part = root
				end
				if part and part:IsA("BasePart") then
					local world = part.Position
					if Config.prediction > 0 then
						local vel = part.AssemblyLinearVelocity or Vector3.zero
						world = world + vel * (Config.prediction + ping)
					end
					local screenPos, onScreen = cam:WorldToViewportPoint(world)
					if onScreen then
						local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						if dist2d <= Config.aimFov and dist2d < bestDist then
							if not Config.wallCheck or isVisible(part) then
								bestDist = dist2d
								best = {
									player = plr,
									char = char,
									part = part,
									position = world,
								}
							end
						end
					end
				end
			end
		end
	end

	return best
end

local function aimAt(target)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local desired = CFrame.lookAt(cam.CFrame.Position, target.position)
	if Config.aimSmooth <= 1 then
		cam.CFrame = desired
	else
		cam.CFrame = cam.CFrame:Lerp(desired, 1 / Config.aimSmooth)
	end
end

local lastFire = 0

local function fire()
	local now = tick()
	if now - lastFire < Config.fireCooldown then return end
	lastFire = now
	if type(mouse1click) == "function" then
		pcall(mouse1click)
	else
		pcall(function()
			mouse1press()
			mouse1release()
		end)
	end
end

