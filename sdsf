local function addSlider(parent, label, key, min, max, step, callback)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 36)
	row.Parent = parent

	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.new(1, -60, 0, 16)
	text.Font = Enum.Font.Gotham
	text.TextSize = 12
	text.TextColor3 = COLOR.text
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.Text = label
	text.Parent = row

	local value = Instance.new("TextLabel")
	value.BackgroundTransparency = 1
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, 0, 0, 0)
	value.Size = UDim2.new(0, 60, 0, 16)
	value.Font = Enum.Font.GothamMedium
	value.TextSize = 12
	value.TextColor3 = COLOR.accent
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.Parent = row

	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 0, 0, 24)
	bar.Size = UDim2.new(1, 0, 0, 6)
	bar.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
	bar.BorderSizePixel = 0
	bar.Parent = row

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 3)
	barCorner.Parent = bar

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = COLOR.accent
	fill.BorderSizePixel = 0
	fill.Parent = bar

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 3)
	fillCorner.Parent = fill

	local dragging = false

	local function fmt(v)
		if step >= 1 then
			return tostring(math.floor(v + 0.5))
		end
		return string.format("%.2f", v)
	end

	local function setFromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local raw = min + (max - min) * rel
		if step and step > 0 then
			raw = math.floor(raw / step + 0.5) * step
		end
		raw = math.clamp(raw, min, max)
		Config[key] = raw
		fill.Size = UDim2.new(rel, 0, 1, 0)
		value.Text = fmt(raw)
		if callback then callback(raw) end
	end

	local function refresh()
		local v = Config[key]
		local rel = (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0
		fill.Size = UDim2.new(rel, 0, 1, 0)
		value.Text = fmt(v)
	end

	refresh()

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	return row
end

