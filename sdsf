	removeESP(plr)
end)

-- fallback ESP for executors without Drawing: billboard name + health
local fallbackLabels = {}

local function updateFallbackESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		local label = fallbackLabels[plr]
		local char, hum = alive(plr)
		local show = Config.espEnabled and not isLocal(plr) and char
		if Config.espTeamCheck and isTeammate(plr) then show = false end

		if show then
			if not label then
				local billboard = Instance.new("BillboardGui")
				billboard.Name = "sk1d_esp"
				billboard.Size = UDim2.new(0, 120, 0, 34)
				billboard.StudsOffset = Vector3.new(0, 3, 0)
				billboard.AlwaysOnTop = true
				billboard.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
				billboard.Parent = char

				local name = Instance.new("TextLabel")
				name.BackgroundTransparency = 1
				name.Size = UDim2.new(1, 0, 0, 16)
				name.Font = Enum.Font.GothamMedium
				name.TextSize = 12
				name.TextColor3 = Color3.fromRGB(255, 255, 255)
				name.TextStrokeTransparency = 0
				name.Text = plr.Name
				name.Parent = billboard

				local health = Instance.new("TextLabel")
				health.BackgroundTransparency = 1
				health.Position = UDim2.new(0, 0, 0, 16)
				health.Size = UDim2.new(1, 0, 0, 14)
				health.Font = Enum.Font.Gotham
				health.TextSize = 11
				health.TextColor3 = Color3.fromRGB(90, 240, 130)
				health.TextStrokeTransparency = 0
				health.Text = "100 / 100"
				health.Parent = billboard

				label = { billboard = billboard, name = name, health = health }
				fallbackLabels[plr] = label
			end
			if hum then
				label.health.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
			end
		elseif label then
			if label.billboard then
				label.billboard:Destroy()
			end
			fallbackLabels[plr] = nil
		end
	end
end

-- ============================== misc ==============================

local originalHitbox = {}
local flyBV, flyBG = nil, nil
local hitboxTimer = 0

local function restoreHitboxes()
	for part, data in pairs(originalHitbox) do
		pcall(function()
			if part and part.Parent then
				part.Size = data.size
				part.CanCollide = data.collide
			end
		end)
	end
	originalHitbox = {}
end

local function applyHitboxes()
	local size = Vector3.new(Config.hitboxSize, Config.hitboxSize, Config.hitboxSize)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			if char then
				for _, name in ipairs({ "Head", "HumanoidRootPart" }) do
					local part = char:FindFirstChild(name)
					if part and part:IsA("BasePart") then
						if not originalHitbox[part] then
							originalHitbox[part] = { size = part.Size, collide = part.CanCollide }
						end
						part.Size = size
						part.CanCollide = false
					end
				end
			end
		end
	end
end

local function clearFly()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hum.PlatformStand = false end
end

local function updateMisc(dt)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	-- noclip
	if Config.noclipEnabled and char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	-- speed / jump
	if hum then
		if Config.speedEnabled then
			hum.WalkSpeed = Config.walkSpeed
		end
		if Config.jumpEnabled then
			pcall(function()
				hum.UseJumpPower = true
				hum.JumpPower = Config.jumpPower
			end)
		end
	end

	-- fly
	if Config.flyEnabled and root and hum then
		if not flyBV then
			flyBV = Instance.new("BodyVelocity")
			flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			flyBV.Velocity = Vector3.zero
			flyBV.Parent = root

			flyBG = Instance.new("BodyGyro")
			flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
			flyBG.Damping = 200
			flyBG.CFrame = root.CFrame
			flyBG.Parent = root

			hum.PlatformStand = true
		end
		local move = hum.MoveDirection
		local up = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up = 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then up = -1 end
		flyBV.Velocity = move * Config.flySpeed + Vector3.new(0, up * Config.flySpeed, 0)
		local cam = workspace.CurrentCamera
		if cam then
			flyBG.CFrame = cam.CFrame
		end
	elseif flyBV then
		clearFly()
	end

	-- hitbox expander
	if Config.hitboxEnabled then
		hitboxTimer = hitboxTimer + dt
		if hitboxTimer >= 0.2 then
			hitboxTimer = 0
			applyHitboxes()
		end
	elseif next(originalHitbox) ~= nil then
		restoreHitboxes()
	end
end

